[Unit]
Description=DDNet nodriver Cloudflare challenge solver (Service B)
After=network-online.target
Wants=network-online.target

# Runs on the machine with a GUI / display where a real browser can start.
# If the machine has a display, add: Environment=DISPLAY=:0
#
# cf_clearance is bound to this machine's egress IP, so service A has to replay
# the request from here as well. If A and this host already share one public IP
# (`curl -s https://ifconfig.me` matches on both), leave `proxy_url` unset and
# nothing extra is needed. Otherwise run a forwarder next to this service
# (tinyproxy, squid, or `ssh -D`) reachable only from A's address, and point that
# peer's `proxy_url` in A's config.yaml at it, e.g.:
#   peers:
#     - name: gui-box-1
#       base_url: http://<this-host>:9100
#       proxy_url: http://<this-host>:8888

[Service]
Type=simple
User=ddnet
Group=ddnet
WorkingDirectory=/opt/ddnet-serverlist-mirror
ExecStart=/opt/ddnet-serverlist-mirror/.venv/bin/ddnet-bypass --host 0.0.0.0 --port 9100 --token CHANGE_ME
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target